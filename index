<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Persona | AI Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #09090b;
            color: #e4e4e7;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #18181b;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #3f3f46;
            border-radius: 10px;
        }

        .glass-panel {
            background: rgba(24, 24, 27, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .generate-glow {
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
        }

        @keyframes progress-animation {
            0% { width: 0%; }
            100% { width: 85%; }
        }
        .animate-progress {
            animation: progress-animation 3s ease-out forwards;
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <!-- TOP BAR -->
    <header class="h-16 border-b border-white/10 flex items-center justify-between px-6 bg-[#09090b] z-20">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-900/20">
                <i data-lucide="zap" class="text-white fill-current"></i>
            </div>
            <span class="text-xl font-bold tracking-tight text-white">Project Persona</span>
        </div>

        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2 px-3 py-1 bg-amber-500/10 border border-amber-500/20 rounded-full">
                <i data-lucide="shield-check" class="w-4 h-4 text-amber-500"></i>
                <span class="text-[10px] font-bold text-amber-500 uppercase tracking-wider">Subscribed</span>
            </div>
            <div class="flex items-center gap-3 border-l border-white/10 pl-6">
                <div class="text-right">
                    <p class="text-sm font-semibold text-white">Rahul N.</p>
                    <p class="text-[10px] text-zinc-500 font-medium uppercase tracking-tighter">Enterprise User</p>
                </div>
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=100&h=100" class="w-10 h-10 rounded-full border border-white/20" alt="Profile">
            </div>
        </div>
    </header>

    <main class="flex flex-1 overflow-hidden">
        
        <!-- LEFT COLUMN: INPUT -->
        <aside class="w-[420px] bg-[#0c0c0e] border-r border-white/10 flex flex-col">
            <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
                <h2 class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.2em] mb-4">Input Face</h2>
                
                <!-- Source Image Display -->
                <div class="relative group rounded-2xl overflow-hidden border-2 border-blue-600/50 mb-8 aspect-[4/5] shadow-2xl">
                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=600" class="w-full h-full object-cover" alt="Primary Face">
                    <div class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                        <span class="text-[10px] bg-blue-600 text-white px-2 py-1 rounded">IMAGE_0.PNG</span>
                    </div>
                </div>

                <!-- Settings Controls -->
                <div class="space-y-5">
                    <h2 class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.2em]">Persona Settings</h2>
                    
                    <!-- Base Model -->
                    <div>
                        <label class="text-xs text-zinc-400 mb-1.5 block ml-1">Base Model</label>
                        <div class="relative">
                            <select class="w-full bg-zinc-900 border border-white/5 rounded-xl px-4 py-3 text-sm appearance-none outline-none focus:border-blue-500/50 transition-colors">
                                <option>SDXL-Custom-Portrait-v2.1</option>
                                <option>Realistic-Vision-v6.0</option>
                            </select>
                            <i data-lucide="chevron-down" class="absolute right-4 top-3.5 w-4 h-4 text-zinc-500"></i>
                        </div>
                    </div>

                    <!-- Custom Prompt -->
                    <div>
                        <label class="text-xs text-zinc-400 mb-1.5 block ml-1">Custom Prompt</label>
                        <textarea class="w-full bg-zinc-900 border border-white/5 rounded-xl px-4 py-3 text-sm h-24 outline-none focus:border-blue-500/50 transition-colors resize-none">Modern entrepreneur, clean suit, city view at dusk</textarea>
                    </div>

                    <!-- Pose Style -->
                    <div>
                        <label class="text-xs text-zinc-400 mb-1.5 block ml-1">Pose Style</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button class="flex items-center gap-2 px-3 py-2 bg-blue-600/20 border border-blue-600/40 rounded-lg text-[11px] text-blue-400">
                                <i data-lucide="move" class="w-3 h-3"></i> Walking (img_1)
                            </button>
                            <button class="flex items-center gap-2 px-3 py-2 bg-zinc-900 border border-white/5 rounded-lg text-[11px] text-zinc-400 hover:bg-zinc-800">
                                <i data-lucide="user" class="w-3 h-3"></i> Sitting (img_0)
                            </button>
                        </div>
                    </div>

                    <!-- Style Presets -->
                    <div>
                        <label class="text-xs text-zinc-400 mb-1.5 block ml-1">Style Preset</label>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-3 py-1.5 bg-white text-black text-xs font-bold rounded-full cursor-pointer">Cinematic</span>
                            <span class="px-3 py-1.5 bg-zinc-900 border border-white/5 text-zinc-400 text-xs rounded-full cursor-pointer hover:border-white/20">Minimalist</span>
                            <span class="px-3 py-1.5 bg-zinc-900 border border-white/5 text-zinc-400 text-xs rounded-full cursor-pointer hover:border-white/20">Anime</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Generate Button -->
            <div class="p-6 bg-[#0c0c0e] border-t border-white/10">
                <button class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-2xl flex items-center justify-center gap-3 transition-all generate-glow">
                    <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                    GENERATE
                </button>
            </div>
        </aside>

        <!-- RIGHT COLUMN: VARIATIONS -->
        <section class="flex-1 bg-[#09090b] overflow-y-auto p-8 custom-scrollbar">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-2xl font-bold text-white">Generated Variations</h2>
                    <p class="text-zinc-500 text-sm mt-1">Consistency Check: 98.4% Match</p>
                </div>
                <div class="flex gap-3">
                    <button class="p-2.5 bg-zinc-900 border border-white/10 rounded-xl hover:bg-zinc-800"><i data-lucide="grid-3x3" class="w-5 h-5"></i></button>
                    <button class="p-2.5 bg-zinc-900 border border-white/10 rounded-xl hover:bg-zinc-800"><i data-lucide="download" class="w-5 h-5"></i></button>
                </div>
            </div>

            <!-- MOCK VARIATIONS GRID -->
            <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6">
                <!-- Each variation uses the same man but in different clothing/backgrounds as requested -->
                
                <!-- Variation 1: Blue Suit -->
                <div class="group relative aspect-[3/4] rounded-2xl overflow-hidden border border-white/10 hover:border-blue-500/50 transition-all cursor-pointer">
                    <img src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&q=80&w=400&h=533" class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-500" alt="Blue Suit">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent opacity-60"></div>
                    <div class="absolute bottom-4 left-4">
                        <p class="text-[10px] font-bold text-blue-400 uppercase tracking-widest">Office / Blue Suit</p>
                    </div>
                </div>

                <!-- Variation 2: European Street -->
                <div class="group relative aspect-[3/4] rounded-2xl overflow-hidden border border-white/10 hover:border-blue-500/50 transition-all cursor-pointer">
                    <img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&q=80&w=400&h=533" class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-500" alt="Street">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent opacity-60"></div>
                    <div class="absolute bottom-4 left-4">
                        <p class="text-[10px] font-bold text-blue-400 uppercase tracking-widest">Street / Casual</p>
                    </div>
                </div>

                <!-- Repeat variations (Simulation of the "dozens" of thumbnails) -->
                <!-- Generating more placeholders with similar looks -->
                <script>
                    const variations = [
                        { label: 'Forest / Athletic', url: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&q=80&w=400' },
                        { label: 'Library / Turtleneck', url: 'https://images.unsplash.com/photo-1550246140-5119ae4790b8?auto=format&fit=crop&q=80&w=400' },
                        { label: 'Beach / Linen', url: 'https://images.unsplash.com/photo-1534030347209-467a5b0ad3e6?auto=format&fit=crop&q=80&w=400' },
                        { label: 'Night City / Neon', url: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&q=80&w=400' },
                        { label: 'Workspace / Grey Suit', url: 'https://images.unsplash.com/photo-1480427719120-28bf0b63e5db?auto=format&fit=crop&q=80&w=400' },
                        { label: 'Sunset / Classic', url: 'https://images.unsplash.com/photo-1519085184581-9db511f208f9?auto=format&fit=crop&q=80&w=400' }
                    ];
                    
                    for(let i=0; i<12; i++) {
                        const v = variations[i % variations.length];
                        document.write(`
                            <div class="group relative aspect-[3/4] rounded-2xl overflow-hidden border border-white/10 hover:border-blue-500/50 transition-all cursor-pointer">
                                <img src="${v.url}" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" alt="Variation">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
                                <div class="absolute bottom-4 left-4">
                                    <p class="text-[10px] font-bold text-blue-400 uppercase tracking-widest">${v.label}</p>
                                </div>
                            </div>
                        `);
                    }
                </script>
            </div>
        </section>
    </main>

    <!-- BOTTOM BAR -->
    <footer class="h-12 bg-zinc-950 border-t border-white/10 flex items-center justify-between px-6 z-20">
        <div class="flex items-center gap-4 w-1/3">
            <span class="text-[10px] font-bold text-zinc-500 uppercase">System Status</span>
            <div class="flex-1 h-1.5 bg-zinc-800 rounded-full overflow-hidden max-w-[200px]">
                <div class="h-full bg-blue-600 animate-progress"></div>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
            </span>
            <span class="text-[10px] font-bold text-zinc-300 uppercase tracking-wider">Processing 120 variations... Face Swap Active</span>
        </div>

        <div class="w-1/3 flex justify-end gap-6">
            <div class="flex items-center gap-2">
                <i data-lucide="cpu" class="w-3 h-3 text-zinc-600"></i>
                <span class="text-[10px] text-zinc-500 font-mono">RTX 4090: 82%</span>
            </div>
            <div class="flex items-center gap-2">
                <i data-lucide="hard-drive" class="w-3 h-3 text-zinc-600"></i>
                <span class="text-[10px] text-zinc-500 font-mono">VRAM: 18.2GB</span>
            </div>
        </div>
    </footer>

    <script>
        // Initialize Lucide Icons
        lucide.createIcons();
    </script>
</body>
</html>
